# Absolute path to the feature-summary.json produced by parseFeature.js
FEATURES_JSON_PATH=./feature-summary.json

# Absolute path to the cucumber project (where `cucumber-js` should run)
CUCUMBER_CWD=.

# Optional: override the binary used to run cucumber. Default: `npx cucumber-js`.
# CUCUMBER_BIN=/usr/local/bin/cucumber-js
